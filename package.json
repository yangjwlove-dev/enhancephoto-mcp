{
  "name": "enhancephoto-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for image metadata inspection, print DPI sizing, quality diagnostics, pixel-art integer upscaling, and web export.",
  "mcpName": "io.github.yangjwlove-dev/enhancephoto-mcp",
  "homepage": "https://enhancephoto.org",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "enhancephoto-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangjwlove-dev/enhancephoto-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/yangjwlove-dev/enhancephoto-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "image",
    "sharp",
    "exif",
    "dpi",
    "print-sizing",
    "pixel-art",
    "image-diagnostics"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "exif-reader": "^2.0.2",
    "sharp": "^0.34.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
